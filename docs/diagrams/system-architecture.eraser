// Callas system architecture (Eraser cloud-architecture diagram)
// Everything runs on one machine. Call text never goes to an outside API.
title Callas system architecture
direction right
colorMode bold
styleMode plain
typeface clean

Browser [icon: monitor, color: gray] {
  Check a message page [icon: message-square]
  Simulate a call page [icon: upload]
  Live call page [icon: mic, label: "Live call page (mic in, verdicts and reply out)"]
  Dataset page [icon: check-square, label: "/dataset: review simulated calls"]
  Studio page [icon: edit, label: "/studio: write a simulated call live"]
}

Web backend [icon: server, color: blue, label: "Web backend (FastAPI, Jinja, HTMX)"] {
  Message route [icon: send, label: "POST /message/check"]
  Call route [icon: file-audio, label: "POST /call/simulate + SSE events"]
  Live socket [icon: radio, label: "WS /ws/live"]
  Dataset routes [icon: list, label: "GET /dataset + POST review"]
  Studio routes [icon: play, label: "POST /studio/start + SSE events"]
}

Orchestrator [icon: git-branch, color: purple, label: "Orchestrator (LangGraph)"] {
  Message graph [icon: file-text]
  Turn graph [icon: repeat, label: "Turn graph: analyze, decide, reply, speak"]
  Call sessions [icon: layers, label: "Call sessions (memory per call, in RAM)"]
  Live call [icon: phone-call, label: "LiveCall (one worker thread, ordered turns)"]
  Analyst agent [icon: help-circle, label: "Analyst agent (tool calling, explains only)"]
}

Speech [icon: headphones, color: teal, label: "Speech (pythaiasr)"] {
  Streaming ASR [icon: mic, label: "Typhoon ASR streaming + silence VAD"]
  File ASR [icon: file-audio, label: "Typhoon ASR offline"]
  Speaker split [icon: users, label: "Speaker split (Nemotron-3 diarization ONNX by default, DIARIZER)"]
}

NLP core [icon: cpu, color: orange, label: "nlp-core slots (PhayaThaiBERT classifier, not connected yet)"] {
  NER slot [icon: tag, label: "NER (rules today)"]
  Classifier slot [icon: shield, label: "Scam check (LLM today)"]
  Summarizer slot [icon: align-left, label: "Summary (LLM today)"]
  PhayaThaiBERT [icon: archive, color: gray, label: "PhayaThaiBERT classifier (notebook, no edge yet)"]
}

Voice agent [icon: shield, color: red, label: "Voice agent"] {
  Decide rules [icon: git-merge, label: "decide(): fixed rules, escalation sticks"]
  Redact [icon: eye-off, label: "Mask call details before the LLM"]
  Safe reply [icon: lock, label: "safe_reply(): leak rules, else template"]
  Voice [icon: volume-2, label: "PyThaiTTS + FastThaiG2P"]
}

Data pipeline [icon: database, color: yellow, label: "data_pipeline (call simulator)"] {
  Simulator graph [icon: git-merge, label: "Simulator graph: plan, caller, receiver, finish"]
  Call store [icon: database, label: "SQLite store (calls, turns, pattern_notes)"]
  Notebook export [icon: file-text, label: "CSV export for the PhayaThaiBERT notebook"]
}

LLM serving [icon: box, color: green] {
  LLM client [icon: code, label: "LLMClient + versioned prompts"]
  DSPy [icon: sliders, label: "DSPy writer + leak judge (optional)"]
  vLLM server [icon: zap, label: "vLLM server (local GPU, settings from .env)"]
}

// Browser to backend
Check a message page > Message route: text
Simulate a call page > Call route: audio file
Live call page > Live socket: mic audio, PCM16 16 kHz

// Backend to orchestrator
Message route > Message graph
Message route > Analyst agent: why
Call route > File ASR
Live socket > Streaming ASR: audio frames

// Speech to orchestrator
File ASR > Speaker split
Speaker split > Call sessions: turns A/B
Streaming ASR > Live call: closed turn
Live call > Call sessions
Call sessions > Turn graph: call context

// Turn graph internals
Message graph > NER slot
Turn graph > NER slot
Turn graph > Classifier slot
Turn graph > Summarizer slot
Turn graph > Decide rules: NLP result
Decide rules > Redact: normal only
Redact > Safe reply: masked context
Safe reply > Voice: checked text

// Dataset review and simulator
Dataset page > Dataset routes: approve or reject
Studio page > Studio routes: start, stop
Dataset routes > Call store: review status
Studio routes > Simulator graph
Simulator graph > Call store: every turn saved
Call store > Notebook export: approved calls only
Simulator graph > vLLM server: DSPy agents

// LLM use
Classifier slot > LLM client
Summarizer slot > LLM client
Safe reply > LLM client: reply job
Safe reply > DSPy: REPLY_ENGINE / LEAK_JUDGE
DSPy > vLLM server
Analyst agent > LLM client: tool calls
LLM client > vLLM server
