# Copy to .env and fill in. .env is gitignored; never commit real values.

# vLLM OpenAI-compatible server (already running somewhere you control).
# Call text goes here, so it must be a server you run, not an outside API.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=your-served-model-name
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_S=30

# ASR (pythaiasr). typhoon_asr = Typhoon FastConformer ONNX, runs offline after first download.
ASR_MODEL=typhoon_asr
# Where pythaiasr keeps downloaded models (defaults to ~/pythaiasr-data).
# PYTHAIASR_DATA_DIR=

# TTS (PyThaiTTS with the FastThaiG2P engine)
TTS_PRETRAINED=fastthaig2p
TTS_SPEAKER=thai_som
