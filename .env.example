# Copy to .env and fill in. .env is gitignored; never commit real values.

# vLLM OpenAI-compatible server (already running somewhere you control).
# Call text goes here, so it must be a server you run, not an outside API.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=your-served-model-name
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_S=30
# Thinking models (Qwen3 etc.) return empty answers with small token limits; keep false.
VLLM_THINKING=false

# How the voice reply is written: prompt (default) or dspy (needs the dspy extra).
REPLY_ENGINE=prompt
# Extra DSPy leak judge on top of the rule check; it can only add blocks: off (default) or on.
LEAK_JUDGE=off

# Local tracing with Phoenix (needs the trace extra and a running server, see README "Tracing").
# The endpoint must be on this machine. TRACE_CALL_TEXT=on keeps call text in web traces.
# TRACING=off
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# TRACE_CALL_TEXT=off

# ASR (pythaiasr). typhoon_asr = Typhoon FastConformer ONNX, runs offline after first download.
# typhoon_nemotron_asr = Typhoon Nemotron 3.5 streaming, INT4 ONNX (665 MB). On CPU about 3x slower
# on the live mic; with onnxruntime-gpu slightly faster than typhoon_asr. On one test clip it kept
# words typhoon_asr dropped. ASR_MODEL sets both the recording and the live call model.
ASR_MODEL=typhoon_asr
# Where pythaiasr keeps downloaded models (defaults to ~/pythaiasr-data).
# PYTHAIASR_DATA_DIR=

# Speaker split: nemotron (Nemotron-3 diarization) or pyannote_segmentation.
DIARIZER=nemotron

# Fix misspelled Thai words in each transcript turn: off or pythainlp. Slow; read issue #30 first.
AUTOCORRECT=off

# TTS (PyThaiTTS with the FastThaiG2P engine)
TTS_PRETRAINED=fastthaig2p
TTS_SPEAKER=thai_som

# nlp-core models by registry name (see nlp_core.registry). Empty: rules, llm, llm.
# NLP_NER=
# NLP_CLASSIFIER=
# NLP_SUMMARIZER=
